{
  "name": "trame",
  "version": "0.18.0",
  "exports": "./main.ts",
  "unstable": [
    "raw-imports"
  ],
  "desktop": {
    "app": {
      "name": "Trame",
      "identifier": "sh.trame.app",
      "icons": {
        "linux": "./assets/icon.png",
        "macos": "./assets/icon.png"
      }
    }
  },
  "tasks": {
    "//": "Compatibility aliases for the native runtime; Deno remains for hub/tests and the legacy exporter.",
    "dev": "cd .. && just dev",
    "bundle": "cd .. && just bundle-appimage",
    "bundle:deb": "cd .. && just bundle",
    "bundle:dir": "cd .. && cargo build -p trame-desktop --release --locked",
    "compile:cli": "cd .. && just compile-cli",
    "serve": "cd .. && just serve",
    "test": "cd .. && just test",
    "web:dev": "cd web && npm install && npm run dev",
    "web:build": "cd web && npm ci && npm run build && npm run build:link"
  },
  "imports": {
    "@clack/prompts": "npm:@clack/prompts@^1.6.0",
    "picocolors": "npm:picocolors@^1.1.1",
    "@bradenmacdonald/s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9.6",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/uuid": "jsr:@std/uuid@^1",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.3",
    "postgres": "npm:postgres@^3.4",
    "ws": "npm:ws@^8.18",
    "@trame/plugin-api": "./plugins/api.ts",
    "@trame/plugin-test": "./test_tmp.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  }
}
