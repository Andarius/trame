#!/usr/bin/env bash
# DESCRIPTION: Check staged Rust, TypeScript and SQL changes before committing.
# USAGE: Invoked by git pre-commit.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^app/.*\.(ts|tsx)$' || true)
staged_sql=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sql$' || true)
staged_rust=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^Cargo\.(toml|lock)$|^crates/.*\.(rs|toml)$)' || true)
[ -z "$staged" ] && [ -z "$staged_sql" ] && [ -z "$staged_rust" ] && exit 0

fail=0
if [ -n "$staged_rust" ]; then
  cargo fmt --all --check || fail=1
  cargo check --workspace --locked || fail=1
fi
gate() {                       # $1 label, $2 tool output
  local label="$1" out="$2"
  if echo "$out" | grep -iE "error|-->|warning" | grep -qE "$staged_re"; then
    echo "✗ $label — issues in staged files:" >&2
    echo "$out" | grep -iE "error TS|error\[|-->|$staged_re" | head -25 >&2
    fail=1
  fi
}

if [ -n "$staged" ]; then
  # match on basenames so it works whether the tool prints web/src/… (deno, absolute)
  # or src/… (tsc, relative to app/web)
  staged_re=$(echo "$staged" | sed 's|.*/||' | sed 's/\./\\./g' | paste -sd'|' -)
  gate "deno lint"  "$( (cd app && deno lint) 2>&1 || true )"
  gate "deno check" "$( (cd app && deno check plugin-host.ts) 2>&1 || true )"
  if echo "$staged" | grep -q '^app/web/src/'; then
    gate "tsc --noEmit" "$( (cd app/web && npx tsc --noEmit) 2>&1 || true )"
  fi
fi

# SQL: lint + format-check each staged .sql file (sqlfluff via uvx, no install needed)
for f in $staged_sql; do
  [ -f "$f" ] || continue
  if ! out=$(uvx sqlfluff@4.2.2 lint "$f" 2>&1); then
    echo "✗ sqlfluff lint — issues in $f:" >&2
    echo "$out" | grep -iE "^L:|\|" | head -25 >&2
    fail=1
  fi
  if ! uvx sqlfluff@4.2.2 format - < "$f" 2>/dev/null | diff -q "$f" - >/dev/null; then
    echo "✗ sqlfluff format — $f is not formatted (run: just fmt-sql)" >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "✗ pre-commit failed. Fix the above, or 'git commit --no-verify' to skip." >&2
  exit 1
fi
echo "✓ pre-commit passed"
