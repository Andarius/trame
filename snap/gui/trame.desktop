[Desktop Entry]
Type=Application
Name=Trame
Comment=Local-first session tracker for Claude Code work
Exec=trame %u
MimeType=x-scheme-handler/trame;
Icon=${SNAP}/opt/trame/AppIcon.png
Terminal=false
Categories=Development;Utility;
# the window's real WM_CLASS/app_id is "trame" (argv0), not the sh.trame.app bundle identifier
StartupWMClass=trame
