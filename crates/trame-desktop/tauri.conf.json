{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trame",
  "version": "0.19.0",
  "identifier": "sh.trame.app",
  "mainBinaryName": "trame",
  "build": { "frontendDist": "splash" },
  "app": { "windows": [], "security": { "csp": "default-src 'self'; style-src 'unsafe-inline'; frame-src 'self' https:" } },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local-first session tracker for coding work",
    "longDescription": "Trame keeps coding sessions, pages, comments, and reports in a local PostgreSQL database.",
    "icon": ["../../app/assets/icon.png"],
    "externalBin": ["../../.scratch/package/tramecli", "../../.scratch/package/trame-migrate-pglite"],
    "resources": {
      "../../.scratch/package/pg/usr/lib/postgresql/18/": "postgres/lib/postgresql/18/",
      "../../.scratch/package/pg/usr/share/postgresql/18/": "postgres/share/postgresql/18/",
      "../../app/web/dist/": "web/"
    },
    "linux": {
      "deb": {
        "depends": ["libicu74", "liburing2", "libnuma1", "libxml2", "libldap2", "libpam0g", "libssl3t64", "libzstd1", "liblz4-1", "libpq5"]
      }
    }
  }
}
